<resources>

    <style name="Theme.Base" parent="Theme.Material3.DynamicColors.DayNight.NoActionBar">
        <!-- 默认 APP 背景：纯黑，保证所有页面（含播放页）都有统一兜底底色。 -->
        <item name="android:windowBackground">@color/black</item>
        <item name="android:statusBarColor">@color/transparent</item>
        <item name="android:navigationBarColor">@color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
    </style>

    <style name="Theme.Splash" parent="Theme.SplashScreen">
        <item name="postSplashScreenTheme">@style/Theme.App</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
    </style>

    <style name="Theme.App" parent="Theme.Base">
        <!-- 去除所有水波纹：高亮色置透明，selectableItemBackground 改为按下浅灰（无波纹动画）。 -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>
        <item name="android:selectableItemBackground">@drawable/bg_press</item>
        <item name="selectableItemBackground">@drawable/bg_press</item>
        <item name="android:selectableItemBackgroundBorderless">@drawable/bg_press</item>
        <item name="selectableItemBackgroundBorderless">@drawable/bg_press</item>
        <!-- 允许内容延伸到刘海/挖孔区域（原 v27 专属配置，合并到此处避免覆盖丢失）。 -->
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <style name="Theme.Crash" parent="Theme.Base">
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowBackground">@color/grey_700</item>
        <!-- 崩溃页同样禁用水波纹：高亮色置透明（页面内 MaterialButton 波纹色走 colorControlHighlight）。 -->
        <item name="android:colorControlHighlight">@android:color/transparent</item>
    </style>

    <style name="Control">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:textColor">@color/yellow</item>
        <item name="android:textSize">14sp</item>
        <item name="android:padding">8dp</item>
    </style>

    <style name="ToolbarTextAppearance" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="titleTextColor">?attr/colorOnSurface</item>
    </style>

</resources>
