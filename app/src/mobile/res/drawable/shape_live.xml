<?xml version="1.0" encoding="utf-8"?>
<!-- 直播列表项：保持底色，按下叠加 30% 浅灰并渐显、抬起渐隐（无波纹），4dp 圆角。 -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <item android:id="@+id/normal">
        <aapt:attr name="android:drawable">
            <shape android:shape="rectangle">
                <solid android:color="@color/selector_live" />
                <corners android:radius="4dp" />
                <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
            </shape>
        </aapt:attr>
    </item>

    <item android:id="@+id/pressed" android:state_pressed="true">
        <aapt:attr name="android:drawable">
            <layer-list>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/selector_live" />
                        <corners android:radius="4dp" />
                        <padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" />
                    </shape>
                </item>
                <item>
                    <shape android:shape="rectangle">
                        <solid android:color="@color/press_overlay" />
                        <corners android:radius="4dp" />
                    </shape>
                </item>
            </layer-list>
        </aapt:attr>
    </item>

    <transition
        android:fromId="@id/normal"
        android:toId="@id/pressed"
        android:reversible="true">
        <animation-list android:oneshot="true">
            <item android:duration="30"><aapt:attr name="android:drawable"><layer-list><item><shape android:shape="rectangle"><solid android:color="@color/selector_live" /><corners android:radius="4dp" /><padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/press_f0" /><corners android:radius="4dp" /></shape></item></layer-list></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><layer-list><item><shape android:shape="rectangle"><solid android:color="@color/selector_live" /><corners android:radius="4dp" /><padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/press_f1" /><corners android:radius="4dp" /></shape></item></layer-list></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><layer-list><item><shape android:shape="rectangle"><solid android:color="@color/selector_live" /><corners android:radius="4dp" /><padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/press_f2" /><corners android:radius="4dp" /></shape></item></layer-list></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><layer-list><item><shape android:shape="rectangle"><solid android:color="@color/selector_live" /><corners android:radius="4dp" /><padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/press_f3" /><corners android:radius="4dp" /></shape></item></layer-list></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><layer-list><item><shape android:shape="rectangle"><solid android:color="@color/selector_live" /><corners android:radius="4dp" /><padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/press_f4" /><corners android:radius="4dp" /></shape></item></layer-list></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><layer-list><item><shape android:shape="rectangle"><solid android:color="@color/selector_live" /><corners android:radius="4dp" /><padding android:left="12dp" android:top="8dp" android:right="12dp" android:bottom="8dp" /></shape></item><item><shape android:shape="rectangle"><solid android:color="@color/press_overlay" /><corners android:radius="4dp" /></shape></item></layer-list></aapt:attr></item>
        </animation-list>
    </transition>

</animated-selector>
