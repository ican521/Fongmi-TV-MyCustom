<?xml version="1.0" encoding="utf-8"?>
<!-- 点播卡片：按下 30% 浅灰渐显、抬起渐隐（无波纹），保持 14dp 圆角。 -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <item android:id="@+id/normal">
        <aapt:attr name="android:drawable">
            <shape android:shape="rectangle">
                <solid android:color="@android:color/transparent" />
                <corners android:radius="14dp" />
            </shape>
        </aapt:attr>
    </item>

    <item android:id="@+id/pressed" android:state_pressed="true">
        <aapt:attr name="android:drawable">
            <shape android:shape="rectangle">
                <solid android:color="@color/press_overlay" />
                <corners android:radius="14dp" />
            </shape>
        </aapt:attr>
    </item>

    <transition
        android:fromId="@id/normal"
        android:toId="@id/pressed"
        android:reversible="true">
        <animation-list android:oneshot="true">
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="rectangle"><solid android:color="@color/press_f0" /><corners android:radius="14dp" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="rectangle"><solid android:color="@color/press_f1" /><corners android:radius="14dp" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="rectangle"><solid android:color="@color/press_f2" /><corners android:radius="14dp" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="rectangle"><solid android:color="@color/press_f3" /><corners android:radius="14dp" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="rectangle"><solid android:color="@color/press_f4" /><corners android:radius="14dp" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="rectangle"><solid android:color="@color/press_overlay" /><corners android:radius="14dp" /></shape></aapt:attr></item>
        </animation-list>
    </transition>

</animated-selector>
