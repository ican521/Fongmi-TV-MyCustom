<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形播放/上一集/下一集按钮：去除波纹，按下时浅灰渐显、抬起渐隐。 -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <item android:id="@+id/normal">
        <aapt:attr name="android:drawable">
            <shape android:shape="oval">
                <solid android:color="#4D000000" />
            </shape>
        </aapt:attr>
    </item>

    <item
        android:id="@+id/pressed"
        android:state_pressed="true">
        <aapt:attr name="android:drawable">
            <shape android:shape="oval">
                <solid android:color="#66434343" />
            </shape>
        </aapt:attr>
    </item>

    <transition
        android:fromId="@id/normal"
        android:toId="@id/pressed"
        android:reversible="true">
        <animation-list android:oneshot="true">
            <item android:duration="30">
                <aapt:attr name="android:drawable">
                    <shape android:shape="oval"><solid android:color="#51151515" /></shape>
                </aapt:attr>
            </item>
            <item android:duration="30">
                <aapt:attr name="android:drawable">
                    <shape android:shape="oval"><solid android:color="#59202020" /></shape>
                </aapt:attr>
            </item>
            <item android:duration="30">
                <aapt:attr name="android:drawable">
                    <shape android:shape="oval"><solid android:color="#5F2C2C2C" /></shape>
                </aapt:attr>
            </item>
            <item android:duration="30">
                <aapt:attr name="android:drawable">
                    <shape android:shape="oval"><solid android:color="#62373737" /></shape>
                </aapt:attr>
            </item>
            <item android:duration="30">
                <aapt:attr name="android:drawable">
                    <shape android:shape="oval"><solid android:color="#643D3D3D" /></shape>
                </aapt:attr>
            </item>
            <item android:duration="30">
                <aapt:attr name="android:drawable">
                    <shape android:shape="oval"><solid android:color="#66434343" /></shape>
                </aapt:attr>
            </item>
        </animation-list>
    </transition>

</animated-selector>
