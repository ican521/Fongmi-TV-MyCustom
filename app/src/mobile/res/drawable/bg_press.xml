<?xml version="1.0" encoding="utf-8"?>
<!-- 全局按钮点击特效：按下时 30% 透明浅灰覆盖层渐显，抬起时渐隐（无波纹）。 -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item
        android:id="@+id/normal"
        android:drawable="@android:color/transparent" />

    <item
        android:id="@+id/pressed"
        android:state_pressed="true"
        android:drawable="@color/press_overlay" />

    <transition
        android:fromId="@id/normal"
        android:toId="@id/pressed"
        android:reversible="true">
        <animation-list android:oneshot="true">
            <item android:duration="30" android:drawable="@color/press_f0" />
            <item android:duration="30" android:drawable="@color/press_f1" />
            <item android:duration="30" android:drawable="@color/press_f2" />
            <item android:duration="30" android:drawable="@color/press_f3" />
            <item android:duration="30" android:drawable="@color/press_f4" />
            <item android:duration="30" android:drawable="@color/press_overlay" />
        </animation-list>
    </transition>

</animated-selector>
