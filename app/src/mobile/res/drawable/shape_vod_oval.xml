<?xml version="1.0" encoding="utf-8"?>
<!-- 播放源圆形标签：按下 30% 浅灰渐显、抬起渐隐（无波纹），保持椭圆裁剪。 -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <item android:id="@+id/normal">
        <aapt:attr name="android:drawable">
            <shape android:shape="oval">
                <solid android:color="@android:color/transparent" />
            </shape>
        </aapt:attr>
    </item>

    <item android:id="@+id/pressed" android:state_pressed="true">
        <aapt:attr name="android:drawable">
            <shape android:shape="oval">
                <solid android:color="@color/press_overlay" />
            </shape>
        </aapt:attr>
    </item>

    <transition
        android:fromId="@id/normal"
        android:toId="@id/pressed"
        android:reversible="true">
        <animation-list android:oneshot="true">
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/press_f0" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/press_f1" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/press_f2" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/press_f3" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/press_f4" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/press_overlay" /></shape></aapt:attr></item>
        </animation-list>
    </transition>

</animated-selector>
