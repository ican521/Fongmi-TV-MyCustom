<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形按钮的按下反馈：平时完全透明（露出底层圆底），按下时叠加一层 30% 白（fab_press_overlay）
     使深灰底明显变亮，无波纹。旧版叠加 30% 深灰（press_overlay）与底色 #242424 过于接近，
     混色后仅 5% 亮度变化，肉眼几乎不可见，故改为白系变亮。 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/fab_press_overlay" />
        </shape>
    </item>

    <item>
        <shape android:shape="oval">
            <solid android:color="@color/transparent" />
        </shape>
    </item>

</selector>
