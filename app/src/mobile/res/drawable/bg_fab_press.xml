<?xml version="1.0" encoding="utf-8"?>
<!-- 圆形按钮（BlurFab）的按下变亮过渡：与卡片按压反馈同款 animated-selector 机制——
     按下时 30% 白（fab_press_overlay）逐帧渐显（4帧×30ms=120ms，与按压缩放同步），
     抬起时 reversible 反向逐帧渐隐。无波纹。 -->
<animated-selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <item android:id="@+id/normal">
        <aapt:attr name="android:drawable">
            <shape android:shape="oval">
                <solid android:color="@color/transparent" />
            </shape>
        </aapt:attr>
    </item>

    <item android:id="@+id/pressed" android:state_pressed="true">
        <aapt:attr name="android:drawable">
            <shape android:shape="oval">
                <solid android:color="@color/fab_press_overlay" />
            </shape>
        </aapt:attr>
    </item>

    <transition
        android:fromId="@id/normal"
        android:toId="@id/pressed"
        android:reversible="true">
        <animation-list android:oneshot="true">
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/fab_press_f0" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/fab_press_f1" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/fab_press_f2" /></shape></aapt:attr></item>
            <item android:duration="30"><aapt:attr name="android:drawable"><shape android:shape="oval"><solid android:color="@color/fab_press_overlay" /></shape></aapt:attr></item>
        </animation-list>
    </transition>

</animated-selector>
