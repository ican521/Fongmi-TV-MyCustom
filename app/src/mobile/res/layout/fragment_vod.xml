<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 内容区铺满整个屏幕（含顶栏之下），滚动时内容从渐变顶栏下穿过。 -->
    <com.fongmi.android.tv.ui.custom.CustomViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶栏后声明使其绘制在内容之上。结构与“我的收藏”页完全一致：纵向 LinearLayoutCompat 内
         独立放置 MaterialToolbar（不经 AppBarLayout，避免其把透明背景同步给标题栏）。
         第一行标题栏沿用收藏页同款默认背景（?attr/colorSurface），不透明；
         第二行分类 tab 承载纯黑→透明渐变，滚动时内容从其下穿过。 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- 第一行标题栏（高 ?attr/actionBarSize，纯黑底）：
             左“首页” → 中间胶囊搜索栏（weight=1 填满中间区域）→ 右历史按钮。
             胶囊内右侧为搜索图标（位置与原菜单搜索钮一致），左侧为轮播热搜词。 -->
        <androidx.appcompat.widget.LinearLayoutCompat
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="?android:windowBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/home_title"
                android:textAppearance="@style/ToolbarTextAppearance" />

            <!-- 胶囊搜索栏：高 40dp、圆角半径 20dp（=高度一半，完美胶囊），
                 与底栏同色 #242424（不透明）+白色 12% 亮边，左右各 12dp 间距，
                 左挨“首页”、右挨历史钮，长度填满中间整段。点击任意位置跳转搜索页。 -->
            <FrameLayout
                android:id="@+id/searchPill"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search_pill"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground">

                <TextView
                    android:id="@+id/hotWord"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="46dp"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:text="@string/search_pill_hint"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp" />

                <!-- 搜索图标独立可点：直接搜索当前显示的热搜词，点击事件不再冒泡给胶囊容器 -->
                <ImageView
                    android:id="@+id/searchIcon"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end|center_vertical"
                    android:layout_marginEnd="2dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="@string/menu_search"
                    android:focusable="true"
                    android:padding="8dp"
                    android:src="@drawable/ic_action_search"
                    app:tint="@color/white" />

            </FrameLayout>

            <ImageView
                android:id="@+id/history"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:contentDescription="@string/app_history"
                android:focusable="true"
                android:padding="12dp"
                android:src="@drawable/ic_action_history"
                app:tint="@color/white" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <!-- 第二行：分类页签整体下移为标题让位；整行铺满屏宽承载纯黑→透明渐变，
             tab 列表自身左右各 8dp 内边距，与下方卡片网格内容区对齐。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_appbar_gradient"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/type_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_type_indicator"
                android:visibility="invisible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/type"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/adapter_type" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <include
        android:id="@+id/progress"
        layout="@layout/view_progress"
        android:visibility="gone" />

    <com.fongmi.android.tv.ui.custom.BlurFab
        android:id="@+id/filter"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="88dp"
        android:visibility="gone"
        app:layout_anchor="@id/pager"
        app:layout_anchorGravity="end|bottom"
        app:layout_behavior="com.fongmi.android.tv.ui.custom.CustomFabBehavior"
        app:fabSrc="@drawable/ic_fab_filter"
        app:fabTint="?attr/colorOnSurface"
        tools:visibility="visible" />

    <com.fongmi.android.tv.ui.custom.BlurFab
        android:id="@+id/link"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="88dp"
        app:layout_anchor="@id/pager"
        app:layout_anchorGravity="end|bottom"
        app:layout_behavior="com.fongmi.android.tv.ui.custom.CustomFabBehavior"
        app:fabSrc="@drawable/ic_fab_link"
        app:fabTint="?attr/colorOnSurface"
        tools:visibility="visible" />

    <com.fongmi.android.tv.ui.custom.BlurFab
        android:id="@+id/top"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="88dp"
        android:tag="top"
        android:visibility="invisible"
        app:layout_anchor="@id/pager"
        app:layout_anchorGravity="end|bottom"
        app:layout_behavior="com.fongmi.android.tv.ui.custom.CustomFabBehavior"
        app:fabSrc="@drawable/ic_fab_top"
        app:fabTint="?attr/colorOnSurface"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>