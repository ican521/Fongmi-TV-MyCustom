<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- 内容区铺满整个屏幕（含顶栏之下），滚动时内容从渐变顶栏下穿过。 -->
    <com.fongmi.android.tv.ui.custom.CustomViewPager
        android:id="@+id/pager"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 顶栏后声明使其绘制在内容之上。结构与“我的收藏”页完全一致：纵向 LinearLayoutCompat 内
         独立放置 MaterialToolbar（不经 AppBarLayout，避免其把透明背景同步给标题栏）。
         第一行标题栏沿用收藏页同款默认背景（?attr/colorSurface），不透明；
         第二行分类 tab 承载纯黑→透明渐变，滚动时内容从其下穿过。 -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- 第一行：与“我的收藏/设置”完全一致的标题栏：左上“首页”，右侧搜索/历史菜单。 -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:menu="@menu/menu_vod"
            app:title="@string/home_title"
            app:titleTextAppearance="@style/ToolbarTextAppearance" />

        <!-- 第二行：分类页签整体下移为标题让位；整行铺满屏宽承载纯黑→透明渐变，
             tab 列表自身左右各 8dp 内边距，与下方卡片网格内容区对齐。 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/bg_appbar_gradient"
            android:clipChildren="false"
            android:clipToPadding="false">

            <View
                android:id="@+id/type_indicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/shape_type_indicator"
                android:visibility="invisible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/type"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                tools:listitem="@layout/adapter_type" />

        </FrameLayout>

    </androidx.appcompat.widget.LinearLayoutCompat>

    <include
        android:id="@+id/progress"
        layout="@layout/view_progress"
        android:visibility="gone" />

    <com.fongmi.android.tv.ui.custom.BlurFab
        android:id="@+id/filter"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="88dp"
        android:visibility="gone"
        app:layout_anchor="@id/pager"
        app:layout_anchorGravity="end|bottom"
        app:layout_behavior="com.fongmi.android.tv.ui.custom.CustomFabBehavior"
        app:fabSrc="@drawable/ic_fab_filter"
        app:fabTint="?attr/colorOnSurface"
        tools:visibility="visible" />

    <com.fongmi.android.tv.ui.custom.BlurFab
        android:id="@+id/link"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="88dp"
        app:layout_anchor="@id/pager"
        app:layout_anchorGravity="end|bottom"
        app:layout_behavior="com.fongmi.android.tv.ui.custom.CustomFabBehavior"
        app:fabSrc="@drawable/ic_fab_link"
        app:fabTint="?attr/colorOnSurface"
        tools:visibility="visible" />

    <com.fongmi.android.tv.ui.custom.BlurFab
        android:id="@+id/top"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="88dp"
        android:tag="top"
        android:visibility="invisible"
        app:layout_anchor="@id/pager"
        app:layout_anchorGravity="end|bottom"
        app:layout_behavior="com.fongmi.android.tv.ui.custom.CustomFabBehavior"
        app:fabSrc="@drawable/ic_fab_top"
        app:fabTint="?attr/colorOnSurface"
        tools:visibility="visible" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>